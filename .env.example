# GEMINI_API_KEY: Required for Gemini AI API calls (Optional if AI features are not explicitly called).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Production Firebase & Firestore configurations (Standard Vite environment variables for Vercel/local deploy)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-app-domain.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app-domain.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
VITE_FIREBASE_DATABASE_ID="optional-named-or-default-firestore-db-id"

# Trusted order write API (leave empty for same-origin /api/orders)
VITE_TRUSTED_ORDER_API_URL=""

# Server-only Vercel environment variables. Never expose these with VITE_.
FIREBASE_ADMIN_PROJECT_ID="your-firebase-admin-project-id"
FIREBASE_ADMIN_CLIENT_EMAIL="your-firebase-admin-client-email"
FIREBASE_ADMIN_PRIVATE_KEY="your-firebase-admin-private-key"
